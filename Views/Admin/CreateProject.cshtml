@model List<Project>
@{
    ViewData["Title"] = "Projects Management";
}

<section class="section admin-panel">
    <div class="container">
        <div class="top-actions">
            <h1>Project Management</h1>
            <a asp-action="CreateProject" class="btn btn-dark">New Project</a>
        </div>

        <div class="panel-box">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Budget</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model)
                    {
                        <tr>
                            <td>@project.Title</td>
                            <td>@project.Category</td>
                            <td>@project.Location</td>
                            <td>₹@project.Budget.ToString("N0")</td>
                            <td>
                                <a asp-action="EditProject" asp-route-id="@project.Id">Edit</a>
                                |
                                <form asp-action="DeleteProject" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@project.Id" />
                                    <button type="submit" class="link-button">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
