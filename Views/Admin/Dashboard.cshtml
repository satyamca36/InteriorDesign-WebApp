@model Project
@{
    ViewData["Title"] = Model.Title;
}

<section class="section single-project">
    <div class="container project-hero">
        <img src="@Model.ImageUrl" alt="@Model.Title" />
        <div class="project-summary">
            <span class="eyebrow">@Model.Category</span>
            <h1>@Model.Title</h1>
            <p>@Model.Description</p>
            <div class="summary-grid">
                <div><strong>Location</strong><span>@Model.Location</span></div>
                <div><strong>Budget</strong><span>₹@Model.Budget.ToString("N0")</span></div>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-dark">Book this style</a>
        </div>
    </div>
</section>
