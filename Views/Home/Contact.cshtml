@{
    ViewData["Title"] = "About Us";
}

<section class="page-banner">
    <div class="container">
        <span class="eyebrow">Our Story</span>
        <h1>Designing spaces rooted in comfort and craft.</h1>
    </div>
</section>

<section class="section">
    <div class="container split-layout">
        <div>
            <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&w=1000&q=80" alt="Interior designer working" class="page-image" />
        </div>
        <div>
            <p>Atelier Luxe is a boutique interior design studio dedicated to shaping beautiful, functional spaces for modern living. Our philosophy is simple: every room should feel intentional, serene, and expressive of the people who live or work there.</p>
            <p>From luxury residences to hospitality and commercial environments, our team blends thoughtful planning, refined materials, and layered details to create homes and workplaces that feel complete.</p>
            <ul class="feature-list">
                <li>Residential and commercial interior styling</li>
                <li>Custom mood boards and concept presentations</li>
                <li>End-to-end project coordination and execution</li>
            </ul>
        </div>
    </div>
</section>
