@model Project
@{
    ViewData["Title"] = "Create Project";
}

<section class="section admin-panel">
    <div class="container form-card wide-card">
        <h2>Create New Project</h2>
        <form asp-action="CreateProject" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="field-row">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" />
            </div>
            <div class="field-row">
                <label asp-for="Category">Category</label>
                <input asp-for="Category" />
            </div>
            <div class="field-row">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" />
            </div>
            <div class="field-row">
                <label asp-for="ImageUrl">Image URL</label>
                <input asp-for="ImageUrl" />
            </div>
            <div class="field-row">
                <label asp-for="Budget">Budget</label>
                <input asp-for="Budget" type="number" step="0.01" />
            </div>
            <div class="field-row">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" rows="5"></textarea>
            </div>
            <div class="field-row checkbox-row">
                <input asp-for="IsFeatured" type="checkbox" />
                <label asp-for="IsFeatured">Featured Project</label>
            </div>

            <button type="submit" class="btn btn-dark">Save Project</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
